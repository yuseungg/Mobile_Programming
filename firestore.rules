rules_version = '2';

// 주인: C — Firestore 보안 규칙 (기획서 7장 「보안 규칙 요지」)
//
// 클라이언트가 막는 것을 서버에서도 똑같이 막는다. 앱을 고쳐 보내도 뚫리지 않아야 한다.
//  - 내 읽기 기록은 나만
//  - 저장 · 대조 열람 · 공개는 되돌릴 수 없고, 대조를 연 뒤에는 해석을 못 고친다
//  - 누적일수는 하루(한국 시간)에 +1만, 서버 시각 기준
//  - 가입은 gmail.com 계정만
//  - 뱃지는 해석을 저장한 시만, 하나씩 추가만
//  - 멈춤 집계는 내 표시와 함께 한 줄씩 ±1만
//  - 공개 대화는 그 시의 해석을 저장한 사람만 읽는다
//  - 공감 수는 공감 문서와 함께 ±1만
// 테스트: firestore_test/ (README 참고)

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 ─────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isMe(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 한국 시간(UTC+9) 날짜
    function kstDay(t) {
      return (t + duration.value(9, 'h')).date();
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function readingPath(userId, poemId) {
      return /databases/$(database)/documents/users/$(userId)/readings/$(poemId);
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/publicConversations/$(conversationId);
    }

    function myEmpathyPath(conversationId) {
      return /databases/$(database)/documents/publicConversations/$(conversationId)/empathies/$(request.auth.uid);
    }

    // 지금 로그인한 사람이 이 시의 해석을 저장했는가 (요청 전 기준)
    function hasSaved(poemId) {
      return signedIn()
        && exists(readingPath(request.auth.uid, poemId))
        && get(readingPath(request.auth.uid, poemId)).data.isSaved == true;
    }

    // 이 요청(트랜잭션 · 배치)이 끝난 뒤 기준
    function hasSavedAfter(userId, poemId) {
      return existsAfter(readingPath(userId, poemId))
        && getAfter(readingPath(userId, poemId)).data.isSaved == true;
    }

    // ── users/{userId} ───────────────────────────────

    function countsReadingDay() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['totalReadingDays', 'lastCountedDate'])
        && request.resource.data.totalReadingDays == resource.data.totalReadingDays + 1
        && request.resource.data.lastCountedDate == request.time
        && kstDay(request.time) != kstDay(resource.data.lastCountedDate);
    }

    // 새로 생긴 뱃지는 정확히 하나, 해석을 저장한 시여야 한다.
    // 위치를 가정하지 않는다 (배열 순서는 요청하는 쪽이 정한다). 중복도 막는다.
    function addsBadge(userId) {
      let before = resource.data.badgeIds;
      let after = request.resource.data.badgeIds;
      let added = after.removeAll(before);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['badgeIds'])
        && after.size() == before.size() + 1
        && after.hasAll(before)
        && added.size() == 1
        && hasSavedAfter(userId, added[0]);
    }

    match /users/{userId} {
      allow read: if signedIn();

      // 가입: gmail.com 계정만, 닉네임 예약(nicknames)과 같은 트랜잭션에서만
      // (앱을 거치지 않고 Firebase에 직접 가입한 계정도 여기서 막힌다)
      allow create: if isMe(userId)
        && request.auth.token.email.lower().matches('.*@gmail[.]com')
        && request.resource.data.keys().hasOnly(['nickname', 'totalReadingDays', 'lastCountedDate', 'badgeIds'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.totalReadingDays == 0
        && request.resource.data.lastCountedDate is timestamp
        && request.resource.data.badgeIds == []
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname)).data.userId == userId;

      allow update: if isMe(userId) && (countsReadingDay() || addsBadge(userId));
      allow delete: if false;
    }

    // ── nicknames/{nickname} — 중복 방지용 예약 ──────

    match /nicknames/{nickname} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.nickname == nickname;
      allow update, delete: if false;
    }

    // ── users/{userId}/readings/{poemId} ─────────────

    function validReading(r) {
      return r.keys().hasOnly(['firstWord', 'markedLines', 'conversation', 'evidenceLines',
                               'interpretation', 'isSaved', 'hasOpenedComparison', 'isPublic',
                               'impressiveLine'])
        && r.firstWord is string && r.firstWord.size() <= 20
        && r.interpretation is string && r.interpretation.size() <= 500
        && r.markedLines is list && r.markedLines.size() <= 100
        && r.evidenceLines is list && r.evidenceLines.size() <= 100
        && r.conversation is list && r.conversation.size() <= 200
        && r.isSaved is bool
        && r.hasOpenedComparison is bool
        && r.isPublic is bool
        && (!r.hasOpenedComparison || r.isSaved)
        // 가장 인상깊은 행 — 고르지 않았으면 키가 없다. 있으면 반드시
        // 내가 멈춘 행 중 하나다 (선택지가 멈춘 행이기 때문이다).
        && (!r.keys().hasAny(['impressiveLine'])
            || (r.impressiveLine is int && r.impressiveLine in r.markedLines));
    }

    function keepsLocks(old, r) {
      return (!old.isSaved || r.isSaved)                                        // 저장은 되돌릴 수 없다
        && (!old.hasOpenedComparison || r.hasOpenedComparison)                  // 대조 열람도
        && (!old.hasOpenedComparison || r.interpretation == old.interpretation) // 대조 후 해석 고정
        && (!(old.isSaved && old.isPublic) || r.isPublic);                      // 공개는 되돌릴 수 없다
    }

    match /users/{userId}/readings/{poemId} {
      allow read: if isMe(userId);
      allow create: if isMe(userId) && validReading(request.resource.data);
      allow update: if isMe(userId)
        && validReading(request.resource.data)
        && keepsLocks(resource.data, request.resource.data);
      allow delete: if false;
    }

    // ── lineStops/{poemId} — 멈춤 집계 ──────────────
    // 한 번에 한 줄만, 내 markedLines가 같이 바뀔 때만, 정확히 ±1.
    // 어느 줄이 바뀌었는지는 같은 배치에서 바뀐 내 markedLines에서 꺼낸다.

    function myMarksChanged(poemId) {
      let after = getAfter(readingPath(request.auth.uid, poemId)).data.markedLines;
      return exists(readingPath(request.auth.uid, poemId))
        ? after != get(readingPath(request.auth.uid, poemId)).data.markedLines
        : after.size() == 1;
    }

    // 내 markedLines에서 늘어난 줄 / 줄어든 줄
    function marksAdded(poemId) {
      let p = readingPath(request.auth.uid, poemId);
      return getAfter(p).data.markedLines.removeAll(exists(p) ? get(p).data.markedLines : []);
    }

    function marksRemoved(poemId) {
      let p = readingPath(request.auth.uid, poemId);
      return exists(p)
        ? get(p).data.markedLines.removeAll(getAfter(p).data.markedLines)
        : [];
    }

    // 늘어난 줄은 정확히 +1, 줄어든 줄은 정확히 -1
    function countsOneStep(poemId, before) {
      let after = request.resource.data.counts;
      let added = marksAdded(poemId);
      let removed = marksRemoved(poemId);
      return added.size() + removed.size() == 1
        && (added.size() == 1
              ? after[string(added[0])] == before.get(string(added[0]), 0) + 1
              : after[string(removed[0])] == before.get(string(removed[0]), 0) - 1);
    }

    match /lineStops/{poemId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['counts'])
        && request.resource.data.counts.size() == 1
        && myMarksChanged(poemId)
        && countsOneStep(poemId, {});
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['counts'])
        && request.resource.data.counts.diff(resource.data.counts).affectedKeys().size() == 1
        && myMarksChanged(poemId)
        && countsOneStep(poemId, resource.data.counts);
      allow delete: if false;
    }

    // ── publicConversations/{conversationId} ─────────
    // id = {userId}_{poemId} (사용자 · 시마다 하나)

    match /publicConversations/{conversationId} {
      // 내 것은 id로 바로 읽을 수 있다 (없는 문서 포함) — 저장 트랜잭션이 존재 여부를 확인한다
      allow get: if signedIn() && conversationId.matches(request.auth.uid + '_.+');
      // 그 외에는 그 시의 해석을 저장한 사람만 (목록 질의는 poemId 조건이 있어야 한다)
      allow read: if hasSaved(resource.data.poemId);

      allow create: if signedIn()
        && conversationId == request.auth.uid + '_' + request.resource.data.poemId
        && request.resource.data.keys().hasOnly(['userId', 'poemId', 'firstWord', 'summary',
                                                  'interpretation', 'empathyCount', 'evidenceLines', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.empathyCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && hasSavedAfter(request.auth.uid, request.resource.data.poemId)
        && getAfter(readingPath(request.auth.uid, request.resource.data.poemId)).data.isPublic == true;

      // 공감 수만, 공감 문서와 함께 ±1
      allow update: if hasSaved(resource.data.poemId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['empathyCount'])
        && (
          (request.resource.data.empathyCount == resource.data.empathyCount + 1
            && !exists(myEmpathyPath(conversationId))
            && existsAfter(myEmpathyPath(conversationId)))
          ||
          (request.resource.data.empathyCount == resource.data.empathyCount - 1
            && exists(myEmpathyPath(conversationId))
            && !existsAfter(myEmpathyPath(conversationId)))
        );
      allow delete: if false;

      match /empathies/{userId} {
        allow read: if isMe(userId)
          && hasSaved(get(conversationPath(conversationId)).data.poemId);
        allow create: if isMe(userId)
          && hasSaved(get(conversationPath(conversationId)).data.poemId)
          && request.resource.data.keys().size() == 0
          && getAfter(conversationPath(conversationId)).data.empathyCount
             == get(conversationPath(conversationId)).data.empathyCount + 1;
        allow delete: if isMe(userId)
          && getAfter(conversationPath(conversationId)).data.empathyCount
             == get(conversationPath(conversationId)).data.empathyCount - 1;
        allow update: if false;
      }
    }

    // 그 밖의 경로는 모두 거부 (기본)
  }
}
