      "label": "전문가 해석 A",
      "stance": "포근하고 나른한 감각으로 읽는 입장",
      "claims": [
        { "lines": [1, 2], "point": "부드러운 털의 촉각을 고운 향기로 옮겨 놓아 봄을 나른하게 만든다" },
        { "lines": [7, 8], "point": "고요히 다물은 입술에 떠도는 포근한 졸음이 봄날의 평온함을 보여 준다" }
      ]
    },
    {
      "label": "전문가 해석 B",
      "stance": "역동적인 생명력으로 읽는 입장",
      "claims": [
        { "lines": [11], "point": "마지막 행에서 푸른 생기가 뛰노는 것으로 끝맺어 봄의 약동을 남긴다" }
      ]
    }
  ]
}
